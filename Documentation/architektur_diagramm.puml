@startuml
package "Settings" {
    [Scriptable Objects\n(GeneralSettings, NoiseSettings, ColourGradient)] as ScriptableObjects
}

package "Core" {
    [EnvironmentGenerator] as EnvironmentGenerator
    [ColourGenerationManager] as ColourGenerationManager
    [GenerationManagerCPU] as GenerationManagerCPU
    [MeshGenerationManager] as MeshGenerationManager
    [NoiseGenerationManager] as NoiseGenerationManager
    [TerrainGenerator] as TerrainGenerator
    [TerrainSettings] as TerrainSettings
    [TerrainGenerationManagers] as TerrainGenerationManagers
}

package "Compute Shaders" {
    [ColourGeneration] as ColourGenerationCompute
    [NoiseGeneration] as NoiseGenerationCompute
    [ValueClamp] as ValueClampCompute
}

package "Helpers" {
    [ComputeBufferManager] as ComputeBufferManager
    [FullscreenGameView] as FullscreenGameView
    [GeneratorFunctions] as GeneratorFunctions
    [OpenSimplexNoise] as OpenSimplexNoise
    [StructsAndEnums] as StructsAndEnums
}

ScriptableObjects --> EnvironmentGenerator : settings
EnvironmentGenerator --> ColourGenerationManager : init
EnvironmentGenerator --> GenerationManagerCPU : init
EnvironmentGenerator --> MeshGenerationManager : init
EnvironmentGenerator --> NoiseGenerationManager : init
EnvironmentGenerator --> TerrainGenerator : uses
EnvironmentGenerator --> TerrainSettings : sets
EnvironmentGenerator --> TerrainGenerationManagers : manages

ColourGenerationManager --> ColourGenerationCompute
NoiseGenerationManager --> NoiseGenerationCompute
GenerationManagerCPU --> ComputeBufferManager
MeshGenerationManager --> ValueClampCompute

TerrainGenerator --> EnvironmentGenerator : generates
ComputeBufferManager --> EnvironmentGenerator : manages

TerrainGenerationManagers --> NoiseGenerationManager : contains
TerrainGenerationManagers --> MeshGenerationManager : contains
TerrainGenerationManagers --> ColourGenerationManager : contains
@enduml








