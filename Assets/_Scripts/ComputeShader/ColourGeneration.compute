#pragma kernel Colour_Mesh 0

// Buffer for storing the vertices
RWStructuredBuffer<float3> Vertex_Buffer;

// Buffer for storing the colours
RWStructuredBuffer<float4> Colour_Buffer;
RWStructuredBuffer<float4> Colour_Palette_Buffer;

int colour_count;

int map_width;
int map_height;

float min_height;
float max_height;

int vertices_buffer_length; // Total length of the vertex buffer

// Function to interpolate colour based on height
float4 interpolate_color(const float value, const float min, const float max)
{
    const float t = (value - min) / (max - min);
    return lerp(float4(0, 0, 0, 1), float4(1, 1, 1, 1), t); // Black to white gradient
}

[numthreads(8, 8, 1)]
void Colour_Mesh(uint3 id : SV_DispatchThreadID)
{
    // Calculate the index based on the thread ID
    const int index = id.y * map_width + id.x;

    // Prevent out-of-bounds access
    if (index < 0 || index >= vertices_buffer_length) {
        return;
    }

    // Get the height of the vertex
    const float height = Vertex_Buffer[index].y;

    float normalized_y = 0.0f;
    if (max_height != min_height) {
        normalized_y = (height - min_height) / (max_height - min_height);
    }    

    // Interpolate color based on normalizedY and ensure no errors
    if (normalized_y >= 0 && normalized_y <= 1)
    {
        for (int i = 0; i < colour_count - 1; i++)
        {
            const float range_start = (float)i / (colour_count - 1);
            const float range_end = (float)(i + 1) / (colour_count - 1);

            if (normalized_y >= range_start && normalized_y <= range_end)
            {
                const float t = (normalized_y - range_start) / (range_end - range_start);
                Colour_Buffer[index] = lerp(Colour_Palette_Buffer[i], Colour_Palette_Buffer[i + 1], t);
                break;
            }
        }
    }
    else
    {
        // Default to white or another fallback color to avoid black regions
        Colour_Buffer[index] = float4(1, 1, 1, 1);
    }
}