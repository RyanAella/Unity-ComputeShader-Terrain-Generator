#pragma kernel NoiseGenerator 0
#pragma kernel ComputeLocalMinMax 1
#pragma kernel ComputeGlobalMinMax 2
#pragma kernel ClampHeightValues 3

#include "Packages/jp.keijiro.noiseshader/Shader/SimplexNoise2D.hlsl"

// Unsigned integer variables for map dimensions.
uint map_width; // Width of the noise map
uint map_height; // Height of the noise map

// Noise generation parameters.
float noise_scale; // Scale of the noise
float noise_height; // Height factor for the noise
int octaves; // Number of noise octaves
float lacunarity; // Frequency multiplier for each octave
float persistence; // Amplitude multiplier for each octave

int vertices_buffer_length; // Total length of the vertex buffer
int local_min_max_buffer_length; // Total length of the local Min/Max buffer

float float_min_value; // Minimum float value
float float_max_value; // Maximum float value

// Read-write structured buffers for noise data and mesh information.
RWStructuredBuffer<float3> VertexBuffer; // Stores the vertices of the mesh
RWStructuredBuffer<int> TriangleBuffer; // Stores the indices for mesh triangles
RWStructuredBuffer<float2> LocalMinMaxBuffer; // Buffer to store local Min/Max values
RWStructuredBuffer<float> GlobalMinMaxBuffer; // Buffer to store global Min/Max values
RWStructuredBuffer<float3> ClampedBuffer; // Stores clamped vertex data

// Helper function for linear interpolation.
float inverseLerp(float from, float to, float value)
{
    if (from == to)
    {
        return 0.0f; // Return 0 if from and to are the same (avoid division by zero)
    }
    return (value - from) / (to - from);
}

// Main kernel for noise generation.
[numthreads(8, 8, 1)]
void NoiseGenerator(uint3 id : SV_DispatchThreadID)
{
    // Ensure the thread ID is within the map dimensions.
    if (id.x >= map_width || id.y >= map_height)
    {
        return; // Exit early if out of bounds
    }

    // Check if the thread is within the map bounds.
    if (id.y < map_height && id.x < map_width)
    {
        float value = 0.0f; // Accumulated noise value
        float amplitude = 1.0f; // Initial amplitude
        float frequency = 1.0f; // Initial frequency

        const int vertex_index = id.y * map_width + id.x; // Calculate vertex index

        // Loop through octaves to generate noise.
        for (int o = 0; o < octaves; o++)
        {
            // Calculate UV coordinates for noise generation.
            const float2 uv = float2(id.x / noise_scale * frequency, id.y / noise_scale * frequency) / float2(
                map_width, map_height);

            // Generate Simplex noise and add to the accumulated value.
            value += amplitude * SimplexNoise(uv);

            // Adjust amplitude and frequency for the next octave.
            amplitude *= persistence;
            frequency *= lacunarity;
        }

        float height = value * 16; // The final noise-based height

        // Create a vertex with the calculated height.
        const float3 vertex = float3(id.x, height, id.y);

        // Store the vertex in the VertexBuffer.
        VertexBuffer[vertex_index] = vertex;
    }

    // Generate triangles if within the map bounds minus one (to avoid out-of-bounds indices).
    if (id.y < map_height - 1 && id.x < map_width - 1)
    {
        const int index = (id.y * (map_width - 1) + id.x) * 6; // Base index for triangles

        const int vertexIndex = id.y * map_width + id.x; // Base index for vertices

        // Store the indices for the two triangles that make up each grid cell.
        TriangleBuffer[index + 0] = vertexIndex + 0;
        TriangleBuffer[index + 1] = vertexIndex + map_width;
        TriangleBuffer[index + 2] = vertexIndex + 1;

        TriangleBuffer[index + 3] = vertexIndex + 1;
        TriangleBuffer[index + 4] = vertexIndex + map_width;
        TriangleBuffer[index + 5] = vertexIndex + map_width + 1;
    }
}

