// Kernel for computing local Min/Max values
[numthreads(16, 16, 1)] // Thread group size (8x8x1)
void Compute_Local_Min_Max(uint3 id : SV_DispatchThreadID)
{
    // Calculate the index based on the thread ID
    const int index = id.y * map_width + id.x;

    // Prevent out-of-bounds access
    if (index >= vertices_buffer_length)
    {
        return; // Exit early to avoid errors
    }

    // Initialize local Min/Max with extreme values
    float min = float_max_value;
    float max = float_min_value;

    // Calculate local Min/Max within the thread group
    for (int i = 0; i < 16; ++i)
    {
        // Ensure the index is within bounds
        if (index + i < vertices_buffer_length)
        {
            // Get the 'y' coordinate from the VertexBuffer
            const float value = _Vertex_Buffer[index + i].y;

            // Update min and max based on the value
            if (value < min)
            {
                min = value;
            }
            if (value > max)
            {
                max = value;
            }
        }
    }

    // Store the calculated local Min/Max values
    _Local_Min_Max_Buffer[index] = float2(min, max);
}

// Kernel for computing global Min/Max values from local data
[numthreads(1, 1, 1)] // Only one thread is needed for global aggregation
void Compute_Global_Min_Max(uint3 id : SV_DispatchThreadID)
{
    // Initialize global Min/Max with extreme values
    float min = float_max_value;
    float max = float_min_value;

    // Loop through all local Min/Max values to find the global Min/Max
    for (int i = 0; i < local_min_max_buffer_length; ++i)
    {
        // Retrieve the local Min/Max values
        float2 min_max = _Local_Min_Max_Buffer[i];

        // Update global Min/Max based on the local values
        if (min_max.x < min)
        {
            min = min_max.x;
        }
        if (min_max.y > max)
        {
            max = min_max.y;
        }
    }

    // Store the global Min/Max values
    _Global_Min_Max_Buffer[0] = min;
    _Global_Min_Max_Buffer[1] = max;
}

[numthreads(16, 16, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // Calculate the index based on the thread ID
    const int index = id.y * map_width + id.x;
    
    // Prevent out-of-bounds access
    if (index >= vertices_buffer_length)
    {
        return; // Exit early to avoid errors
    }

    // Initialize local Min/Max with extreme values
    float min = FLT_MAX;
    float max = FLT_MIN;

    // Ensure the index is within bounds
    if (index < vertices_buffer_length)
    {
        // Get the 'y' coordinate from the VertexBuffer
        float3 vertex = _Vertex_Buffer[index];
        float y = vertex.y;

        // Update min and max based on the value
        if (y < min)
        {
            min = y;
        }
        if (y > max)
        {
            max = y;
        }
    }

    Output_Buffer[0] = min;
    Output_Buffer[1] = max;
}

[numthreads(8, 8, 1)] // Thread group size (8x8x1)
void Clamp_Height_Values(uint3 id : SV_DispatchThreadID)
{
    // Ensure the thread ID is within the map dimensions.
    if (id.x >= map_width || id.y >= map_height)
    {
        return; // Exit early if out of bounds
    }

    // Initialize local Min/Max with extreme values
    const float min = _Global_Min_Max_Buffer[0];
    const float max = _Global_Min_Max_Buffer[1];

    if (id.y < map_height)
    {
        if (id.x < map_width)
        {
            // Calculate the index based on the thread ID
            const int index = id.y * map_width + id.x;

            float3 vertex = _Vertex_Buffer[index];

            // Clamping noise height to normalized range using Min/Max
            float normalized_height = inverse_lerp(min, max, vertex.y);

            _Clamped_Buffer[index] = float3(vertex.x, normalized_height, vertex.z);
        }
    }
}
