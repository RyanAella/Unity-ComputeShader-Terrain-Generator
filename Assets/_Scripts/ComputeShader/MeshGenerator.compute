#pragma kernel ComputeLocalMinMax 1

RWStructuredBuffer<float2> LocalMinMaxBuffer; // Buffer für lokale Min/Max-Werte

int vertices_buffer_length;

[numthreads(8, 8, 1)]
void ComputeLocalMinMax(uint3 id : SV_DispatchThreadID)
{
    uint index = id.y * map_width + id.x;

    if (index >= vertices_buffer_length) return; // Verhindert Out-of-Bounds-Fehler

    float min = float_max_value;
    float max = float_min_value;

    // Berechne lokale Min/Max-Werte innerhalb der Threadgruppe
    for (uint i = 0; i < 8; ++i)
    {
        if (index + i < vertices_buffer_length)
        {
            float value = VertexBuffer[index + i].y; // Die y-Koordinate für Min/Max
            if (value < min)
            {
                min = value;
            }
            if (value > max)
            {
                max = value;
            }
        }
    }

    LocalMinMaxBuffer[id.y * map_width + id.x] = float2(min, max); // Speichere lokale Min/Max-Werte
}

#pragma kernel ComputeGlobalMinMax 2

RWStructuredBuffer<float2> GlobalMinMaxBuffer; // Buffer für globale Min/Max-Werte

int local_min_max_buffer_length;

[numthreads(1, 1, 1)] // Nur ein Thread erforderlich, da wir globale Werte aggregieren
void ComputeGlobalMinMax(uint3 id : SV_DispatchThreadID)
{
    float min = float_max_value;
    float max = float_min_value;

    // Aggregiere globale Min/Max-Werte
    for (uint i = 0; i < local_min_max_buffer_length; ++i) 
    {
        float2 minMax = LocalMinMaxBuffer[i];
        if (minMax.x < min) 
        {
            min = minMax.x;
        }
        if (minMax.y > max) 
        {
            max = minMax.y;
        }
    }

    GlobalMinMaxBuffer[0] = float2(min, max); // Speichere globale Min/Max-Werte
}

