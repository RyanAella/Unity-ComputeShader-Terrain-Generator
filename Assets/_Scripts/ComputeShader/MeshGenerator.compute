#pragma kernel NoiseGenerator 0

#include "ColourGenerator.compute"
#include "Packages/jp.keijiro.noiseshader/Shader/SimplexNoise2D.hlsl"

// Unsigned integer variables for map dimensions.
uint map_width;
uint map_height;

float noise_scale;
float noise_height;

int octaves;
float lacunarity;
float persistence;

float float_min_value;
float float_max_value;

// Convert floats to ints with a scaling factor
const float SCALING_FACTOR = 1000.0f;

// Read-write structured buffers for storing noise data and triangle indices.
RWStructuredBuffer<float3> VertexBuffer;
RWStructuredBuffer<int> TriangleBuffer;

RWStructuredBuffer<float3> ClampedBuffer;

// RWStructuredBuffer<int> MinMaxBuffer;

float inverseLerp(float from, float to, float value)
{
    if (from == to)
    {
        return 0.0f; // Avoid division by zero
    }
    return (value - from) / (to - from);
}

// Thread group size for the compute shader.
[numthreads(8,8,1)]
void NoiseGenerator(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= map_width || id.y >= map_height)
    {
        return; // Ensure thread ID is within bounds
    }

    float min_noise_height = float_max_value;
    float max_noise_height = float_min_value;
    // MinMaxBuffer[0] = float_max_value;
    // MinMaxBuffer[1] = float_min_value;

    // Check if the current thread ID is within the bounds of the map dimensions.
    if (id.y < map_height)
    {
        if (id.x < map_width)
        {
            float value = 0.0;
            float amplitude = 1.0;
            float frequency = 1.0;

            // Calculate the vertex index based on the thread ID.
            int vertex_index = id.y * map_width + id.x;

            for (int o = 0; o < octaves; o++)
            {
                // Calculate noise value with modified amplitude and frequency.
                // Normalize the thread ID to a UV coordinate for noise generation.
                float2 uv = float2(id.x / noise_scale * frequency, id.y / noise_scale * frequency) / float2(
                    map_width, map_height);
                // Generate noise value and scale it.
                value += amplitude * SimplexNoise(uv);

                amplitude *= persistence;
                frequency *= lacunarity;
            }

            float height = value /** noise_height*/;

            // int int_height = (int)(height * SCALING_FACTOR); // Convert float to int for interlock
            // MinMaxBuffer[0] = (int)(MinMaxBuffer[0] * SCALING_FACTOR); // Convert float to int for interlock
            // MinMaxBuffer[1] = (int)(MinMaxBuffer[1] * SCALING_FACTOR); // Convert float to int for interlock
            // InterlockedMin(MinMaxBuffer[0], int_height);
            // InterlockedMax(MinMaxBuffer[1], int_height);

            float3 vertex = float3(id.x, height, id.y);

            // Store the noise value in the NoiseBuffer.
            VertexBuffer[vertex_index] = vertex;
        }
    }

    // if (id.y < map_height)
    // {
    //     if (id.x < map_width)
    //     {
    //         int vertex_index = id.y * map_width + id.x;
    //
    //         float3 vertex = VertexBuffer[vertex_index];
    //
    //         // Clamping noise height to normalized range using int Min/Max
    //         float min = (float)(MinMaxBuffer[0]) / SCALING_FACTOR;
    //         float max = (float)(MinMaxBuffer[1]) / SCALING_FACTOR;
    //
    //         float normalized_height = inverseLerp(min, max, vertex.y);
    //
    //         ClampedBuffer[vertex_index] = float3(id.x, normalized_height, id.y);
    //     }
    // }

    // Check if the current thread ID is within the bounds of the map dimensions minus one.
    if (id.y < map_height - 1)
    {
        if (id.x < map_width - 1)
        {
            // Calculate the index for the triangles buffer based on the thread ID.
            int index = (id.y * (map_width - 1) + id.x) * 6;
            int vertexIndex = id.y * map_width + id.x;

            // Store the triangle indices in the TrianglesBuffer.
            TriangleBuffer[index + 0] = vertexIndex + 0;
            TriangleBuffer[index + 1] = vertexIndex + map_width;
            TriangleBuffer[index + 2] = vertexIndex + 1;
            TriangleBuffer[index + 3] = vertexIndex + 1;
            TriangleBuffer[index + 4] = vertexIndex + map_width;
            TriangleBuffer[index + 5] = vertexIndex + map_width + 1;
        }
    }
}

