float3 noise(float2 xy)
{
    float sample_x = xy.x;
    float sample_y = xy.y;

    // Calculate UV coordinates for noise generation.
    const float2 uv = float2(sample_x, sample_y) / float2(map_width, map_height);

    // Generate Simplex noise and add it to the accumulated value.
    float3 value = SimplexNoise(uv);

    return value;
}

float3 fractional_brownian_motion(float2 xy)
{
    float sample_x = xy.x;
    float sample_y = xy.y;

    // Initialize the accumulated noise value to zero.
    float3 value = float3(0.0f, 0.0f, 0.0f);
    // Initialize the initial amplitude for noise generation.
    float amplitude = 1.0f;
    // Initialize the initial frequency for noise generation.
    float frequency = 1.0f;

    // Loop through the specified number of octaves to generate noise.
    for (int o = 0; o < octaves; o++)
    {
        // Calculate UV coordinates for noise generation.
        const float2 uv = float2(sample_x * frequency, sample_y * frequency);

        // Generate Simplex noise and add it to the accumulated value.
        value += amplitude * /*abs*/(noise(uv));

        // Increase the amplitude and frequency for the next octave to add more detail to the noise.
        amplitude *= persistence;
        frequency *= lacunarity;
    }

    return
        value;
}

float3 fractional_brownian_motion_domain_warping(float2 xy)
{
    float sample_x = xy.x;
    float sample_y = xy.y;

    // Initialize the accumulated noise value to zero.
    float3 value = float3(0.0f, 0.0f, 0.0f);
    // Initialize the initial amplitude for noise generation.
    float amplitude = 1.0f;
    // Initialize the initial frequency for noise generation.
    float frequency = 1.0f;

    // Loop through the specified number of octaves to generate noise.
    for (int o = 0; o < octaves; o++)
    {
        // Calculate UV coordinates for noise generation.
        const float2 uv = float2(sample_x * frequency, sample_y * frequency) / float2(map_width, map_height);

        // Generate Simplex noise and add it to the accumulated value.
        // value += abs(amplitude * SimplexNoise(uv));
        value += amplitude * abs(SimplexNoise(uv));

        // Increase the amplitude and frequency for the next octave to add more detail to the noise.
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    // return -value;
    return value;
}

float3 domain_warping(const float2 xy)
{
    float2 p = xy;

    float2 q, r;

    q.x = fractional_brownian_motion(p + float2(0.0, 0.0)).y;
    q.y = fractional_brownian_motion(p + float2(5.2, 1.3)).y;

    // float3 value = fractional_brownian_motion(float2(fbm1, fbm2));

    r.x = fractional_brownian_motion(p + 4.0 * q + float2(1.7, 9.2)).y;
    r.y = fractional_brownian_motion(p + 4.0 * q + float2(8.3, 2.8)).y;

    float3 value = fractional_brownian_motion(p + 4.0f * r);

    return value;
}

float2 CalculateWarpFactor(float2 position)
{
    float2 warpFactor = float2(0.0, 0.0);

    warpFactor.x = clamp(sin(position.x * 10.0) * 0.1, -0.01, 0.01);
    warpFactor.y = clamp(cos(position.y * 10.0) * 0.1, -0.01, 0.01);

    return warpFactor;
}

float falloff(float2 pos, float island_radius)
{
    // float gradient = 1;
    //
    // gradient /= (x * y) / (map_width * map_height) * (1 - (x / map_width)) * (1 - (y / map_height));
    // // gradient -= 16;
    // gradient /= island_radius;
    //
    // return gradient;

    float x = (pos.x / (255 + 1)) * 2 - 1;
    float y = (pos.y / (255 + 1)) * 2 - 1;

    float value = max(abs(x), abs(y));

    float a = 1.23f;
    float b = 1.38f;

    return 1 - (pow(value, a) / (pow(value, a) + pow((b - b * value), a)));
}

