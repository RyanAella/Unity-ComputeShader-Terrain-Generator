float3 make_noise(const int vertex_index, const float sample_x, const float sample_y)
{
    float3 value = float3(0.0f, 0.0f, 0.0f);

    if (noise_type == 0)
    {
        value = noise(float2(sample_x, sample_y));
    }
    else if (noise_type == 1)
    {
        value = fractional_brownian_motion(float2(sample_x, sample_y));
    }
    else if (noise_type == 2)
    {
        value = domain_warping(float2(sample_x, sample_y));
    }
    
    return value;
}

float falloff(float x, float y, float radius, float distortionScale)
{
    // Konvertiere die Eingabewerte in eine 2D-Position relativ zum Inselradius
    float2 position = float2(x, y) / radius;
    
    // Verzerrung der Position basierend auf Simplex-Noise
    float noise = SimplexNoise(position * distortionScale).x;
    
    // Berechne den Abstand vom Zentrum der Insel
    float dist = length(position);
    
    // Berechne den Fall-Off-Wert und wende eine quadratische Dämpfung an
    float falloff_value = 1.0f - pow(clamp(dist + noise, 0.0f, 1.0f), 2.0f);
    
    return falloff_value;
}


/// <summary>
/// Generates noise for each thread ID within the map dimensions.
/// </summary>
/// <param name="id">The thread ID.</param>
/// <returns>The generated noise value for the thread ID.</returns>
[numthreads(16, 16, 1)]
void Noise_Generator(uint3 id : SV_DispatchThreadID)
{
    // Ensure the thread ID is within the map dimensions.
    if (id.x >= map_width || id.y >= map_height)
    {
        return; // Exit early if out of bounds
    }

    // Check if the current thread is within the bounds of the noise map.
    if (id.y < map_height && id.x < map_width)
    {
        // Calculate the index of the vertex in the buffer.
        const int vertex_index = id.y * map_width + id.x;

        // Calculate the sample coordinates for noise generation.
        const float sample_x = (id.x + seed_offset) * noise_scale;
        const float sample_y = (id.y + seed_offset) * noise_scale;

        float3 value = make_noise(vertex_index, sample_x, sample_y);

        // // // // Apply the falloff map
        // float falloff_value = falloff((float)id.x, (float)id.y); // Example distortionScale
        // value -= falloff_value;

        // Apply the falloff map
        float falloff_value = falloff(id.x, id.y, island_radius, 25.0f); // Example distortionScale
        value -= falloff_value;

        // Calculate the position of the vertex in world space.
        const float top_left_x = (map_width - 1) / -2.0f;
        const float top_left_z = (map_height - 1) / -2.0f;
        const float3 vertex = float3(top_left_x + id.x, value.y, top_left_z + id.y);

        // Store the vertex position in the vertex buffer.
        _Vertex_Buffer[vertex_index] = vertex;
    }

    // if (id.y < map_height && id.x < map_width)
    // {
    //     for (int i = 0; i < vertexIndex; i++)
    //     {
    //         float height = _Vertex_Buffer[i].y;
    //
    //         if (height >= 0.5f)
    //         {
    //             // height *= 0.75f;
    //             height += ridgeNoise(height);
    //             // height = lerp(_Vertex_Buffer[i].y, height, 0.125f);
    //             _Vertex_Buffer[i] = float3(_Vertex_Buffer[i].x, height, _Vertex_Buffer[i].z);
    //         }
    //         // else if (height >= 0.7f)
    //         // {
    //         //     height *= 0.5f;
    //         //     _Vertex_Buffer[i] = float3(_Vertex_Buffer[i].x, height, _Vertex_Buffer[i].z);
    //         // }
    //         // else if (height >= 0.5f)
    //         // {
    //         //     height *= 0.25f;
    //         //     _Vertex_Buffer[i] = float3(_Vertex_Buffer[i].x, height, _Vertex_Buffer[i].z);
    //         // }
    //     }
    // }

    // Generate triangles if within the map bounds minus one (to avoid out-of-bounds indices).
    if (id.y < map_height - 1 && id.x < map_width - 1)
    {
        const int index = (id.y * (map_width - 1) + id.x) * 6; // Base index for triangles

        const int vertex_index = id.y * map_width + id.x; // Base index for vertices

        // Store the indices for the two triangles that make up each grid cell.
        _Triangle_Buffer[index + 0] = vertex_index + 0;
        _Triangle_Buffer[index + 1] = vertex_index + map_width;
        _Triangle_Buffer[index + 2] = vertex_index + 1;

        _Triangle_Buffer[index + 3] = vertex_index + 1;
        _Triangle_Buffer[index + 4] = vertex_index + map_width;
        _Triangle_Buffer[index + 5] = vertex_index + map_width + 1;
    }
}
