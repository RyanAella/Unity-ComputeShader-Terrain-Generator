// Define kernel functions for the compute shader.
#pragma kernel Noise_Generator 0

// Include the SimplexNoise2D shader for generating noise.
#include "Packages/jp.keijiro.noiseshader/Shader/SimplexNoise2D.hlsl"

#define SQRT_2 1.41421356237 // Precomputed square root of 2

// Unsigned integer variables for the dimensions of the noise map.
uint map_width; // Width of the noise map
uint map_height; // Height of the noise map

// Parameters for noise generation.
// float seed_offset; // Offset for the noise seed
float noise_scale; // Scale of the noise
float noise_height; // Height factor for the noise
int octaves; // Number of noise octaves
float lacunarity; // Frequency multiplier for each octave
float persistence; // Amplitude multiplier for each octave
float2 offset; // Offset for the noise

float max_terrain_height; // Maximum height of the terrain

int noise_type;

// Read-write structured buffers for noise data and mesh information.
RWStructuredBuffer<float3> _Vertex_Buffer; // Stores the vertices of the mesh
RWStructuredBuffer<int> _Triangle_Buffer; // Stores the indices for mesh triangles

float random_between()
{
    float min = -100000;
    float max = 100000;

    // Verwenden Sie die aktuelle Zeit als Basis für die Zufallszahlengenerierung.
    // Die frac-Funktion gibt den fraktionären Teil der Zeit zurück, was zu einer stetig wechselnden Zahl führt.
    float rand = frac(sin(dot(float2(min, max), float2(12.9898, 78.233))) * 43758.5453);

    // Skalieren Sie die Zufallszahl, um sie in den gewünschten Bereich zu bringen.
    return min + rand * (max - min);
}

float3 noise(const float2 xy)
{
    // Calculate UV coordinates for noise generation.
    const float2 uv = xy / float2(map_width, map_height);

    // Generate Simplex noise and add it to the accumulated value.
    float3 value = SimplexNoise(uv);

    return value;
}

float3 fractional_brownian_motion(float2 xy)
{
    // Initialize the accumulated noise value to zero.
    float3 value = float3(0.0f, 0.0f, 0.0f);
    // Initialize the initial amplitude for noise generation.
    float amplitude = 1.0f;
    // Initialize the initial frequency for noise generation.
    float frequency = 1.0f;

    // Loop through the specified number of octaves to generate noise.
    for (int o = 0; o < octaves; o++)
    {
        float2 octave_offset = float2(random_between() + offset.x, random_between() + offset.y);
        
        // Calculate UV coordinates for noise generation.
        const float2 uv = xy * frequency + octave_offset;

        // Generate Simplex noise and add it to the accumulated value.
        value += amplitude * /*abs*/(noise(uv));

        // Increase the amplitude and frequency for the next octave to add more detail to the noise.
        amplitude *= persistence;
        frequency *= lacunarity;
    }

    return value;
}

float3 domain_warping(const float2 xy)
{
    const float2 p = xy;

    float2 q, r;

    q.x = fractional_brownian_motion(p + float2(0.0, 0.0)).y;
    q.y = fractional_brownian_motion(p + float2(5.2, 1.3)).y;

    // float3 value = fractional_brownian_motion(float2(fbm1, fbm2));

    r.x = fractional_brownian_motion(p + 4.0 * q + float2(1.7, 9.2)).y;
    r.y = fractional_brownian_motion(p + 4.0 * q + float2(8.3, 2.8)).y;

    return fractional_brownian_motion(p + 4.0f * r);
}

float ridge_noise(const float y)
{
    float n = abs(y); // create creases
    n = 1 - n; // invert so creases are at top
    // n = n * n; // sharpen creases

    return n;
}

